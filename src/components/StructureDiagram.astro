---
/** Use case → Challenges → Governance responses → tools → Catalogue of Tools & Metrics. */
const steps = ['Use case', 'Challenges', 'Governance responses', 'Technical / procedural tools', 'Catalogue of Tools & Metrics'];
const H = { w: 176, h: 64, gap: 30 };
const V = { w: 280, h: 46, gap: 26 };
---
<figure class="diagram">
  <svg class="diagram-h" viewBox={`0 0 ${steps.length * H.w + (steps.length - 1) * H.gap + 4} ${H.h + 44}`} role="img" aria-labelledby="dg-title dg-desc">
    <title id="dg-title">How use cases relate to the Catalogue of Tools &amp; Metrics</title>
    <desc id="dg-desc">A use case lists challenges; challenges are addressed by governance responses; responses that are technical or procedural tools could link to the OECD Catalogue of Tools &amp; Metrics. The first three are recorded in this resource.</desc>
    <defs>
      <marker id="arrow-h" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" class="dg-arrowhead" />
      </marker>
    </defs>
    <rect x="1" y="1" width={3 * H.w + 2 * H.gap + 14} height={H.h + 40} rx="12" class="dg-zone" />
    <text x="12" y={H.h + 34} class="dg-zone-label">Recorded in this resource</text>
    {steps.map((s, i) => {
      const x = 8 + i * (H.w + H.gap);
      const words = s.split(' ');
      const half = Math.ceil(words.length / 2);
      const lines = s.length > 14 && words.length > 1 ? [words.slice(0, half).join(' '), words.slice(half).join(' ')] : [s];
      return (
        <g>
          <rect x={x} y="8" width={H.w - 16} height={H.h} rx="8" class={i === steps.length - 1 ? 'dg-box dg-ext' : 'dg-box'} />
          {lines.map((line, j) => (
            <text x={x + (H.w - 16) / 2} y={8 + H.h / 2 + (j - (lines.length - 1) / 2) * 18 + 5} text-anchor="middle" class="dg-text">{line}</text>
          ))}
          {i < steps.length - 1 && (
            <line x1={x + H.w - 14} y1={8 + H.h / 2} x2={x + H.w + H.gap - 4} y2={8 + H.h / 2} class="dg-line" marker-end="url(#arrow-h)" />
          )}
        </g>
      );
    })}
  </svg>
  <svg class="diagram-v" viewBox={`0 0 ${V.w + 4} ${steps.length * (V.h + V.gap) + 10}`} role="img" aria-labelledby="dgv-title">
    <title id="dgv-title">How use cases relate to the Catalogue of Tools &amp; Metrics</title>
    <defs>
      <marker id="arrow-v" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" class="dg-arrowhead" />
      </marker>
    </defs>
    <rect x="1" y="1" width={V.w + 2} height={3 * (V.h + V.gap) - V.gap / 2 + 18} rx="12" class="dg-zone" />
    <text x={V.w - 6} y={3 * (V.h + V.gap) - V.gap / 2 + 12} text-anchor="end" class="dg-zone-label">Recorded in this resource</text>
    {steps.map((s, i) => {
      const y = 10 + i * (V.h + V.gap) + (i >= 3 ? 10 : 0);
      return (
        <g>
          <rect x="22" y={y} width={V.w - 40} height={V.h} rx="8" class={i === steps.length - 1 ? 'dg-box dg-ext' : 'dg-box'} />
          <text x={V.w / 2 + 2} y={y + V.h / 2 + 5} text-anchor="middle" class="dg-text">{s}</text>
          {i < steps.length - 1 && (
            <line x1={V.w / 2 + 2} y1={y + V.h + 2} x2={V.w / 2 + 2} y2={y + V.h + V.gap - 4 + (i === 2 ? 10 : 0)} class="dg-line" marker-end="url(#arrow-v)" />
          )}
        </g>
      );
    })}
  </svg>
  <figcaption>
    Governance responses that take the form of technical or procedural tools could link to the OECD Catalogue of Tools
    &amp; Metrics; the use cases themselves, and responses that are not tools, are recorded in this resource.
  </figcaption>
</figure>

<style>
  .diagram { margin: 16px 0 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; }
  svg { width: 100%; height: auto; display: block; }
  .diagram-v { display: none; max-width: 340px; margin: 0 auto; }
  @media (max-width: 700px) {
    .diagram-h { display: none; }
    .diagram-v { display: block; }
  }
  .dg-zone { fill: var(--surface-alt); stroke: var(--border); stroke-dasharray: 6 4; }
  .dg-zone-label { fill: var(--muted); font-size: 12px; font-family: var(--font); }
  .dg-box { fill: var(--surface); stroke: var(--accent); stroke-width: 2; }
  .dg-ext { stroke-dasharray: 5 3; fill: var(--accent-soft); }
  .dg-text { fill: var(--text); font-size: 14px; font-weight: 600; font-family: var(--font); }
  .dg-line { stroke: var(--muted); stroke-width: 2; }
  .dg-arrowhead { fill: var(--muted); }
  figcaption { margin-top: 12px; color: var(--muted); font-size: 0.95rem; }
</style>
