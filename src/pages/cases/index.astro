---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import CaseExplorer from '../../components/CaseExplorer';
import { url } from '../../lib/url';
import { explorerProps } from '../../lib/explorer';
import { getTaxonomy } from '../../lib/taxonomy';

const props = explorerProps(await getTaxonomy());
---
<Base title="Use cases" description="Browse fictional example use cases of agentic AI in organisations." section="cases">
  <div class="section-head">
    <h1>Use cases</h1>
    <Badge kind="mvp" />
  </div>
  <p class="lead">
    Each use case is described through common fields that allow comparison, and in the organisation's own words.
    Use the filters to narrow the list. Results are not ranked.
  </p>
  <p><a class="btn" href={url('/submit/')}>Submit a use case</a> <a href={url('/compare/')}>Compare use cases</a> <Badge kind="later" /></p>
  <aside class="panel stats" aria-labelledby="stats-h">
    <div class="section-head">
      <h2 id="stats-h">Summary statistics</h2>
      <Badge kind="later" />
    </div>
    <p>
      Totals, such as the number of use cases by sector, region and application area, could be shown here once the
      collection is large enough for them to be meaningful.
    </p>
  </aside>
  <CaseExplorer client:load {...props} />
</Base>

<style>
  .stats { margin: 16px 0 0; border-style: dashed; }
  .stats h2 { margin: 0; font-size: 1rem; }
  .stats p { margin: 4px 0 0; font-size: 0.9rem; color: var(--muted); }
</style>
